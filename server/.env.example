PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://cfd:cfd_secret@localhost:5432/eud_remote_assist
OIDC_ISSUER=https://auth.example.com/application/o/eud-remote-assist/
OIDC_AUDIENCE=eud-remote-assist
OIDC_JWKS_URI=
CORS_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=https://remote.example.com:8448
# The app APK is imported from APP_SEED_DIR (default /seed; the repo's dist/ when running locally):
# APP_SEED_DIR=../dist
# Portal UI tokens persist under ../data when running the API locally:
# PORTAL_SETTINGS_DIR=../data
# ── External services (3.2.0+) ─────────────────────────────────────────────
# Leave a value empty for the built-in default; set it to "none" to turn the service off.

# WebRTC STUN, used by the admin browser and the device. Comma-separated.
# STUN_URLS=stun:stun.l.google.com:19302
# TURN relay. When TURN_URL is set it overrides Portal Configuration → TURN.
# Use the port your TURN server actually listens on (infra-TAK's CoTURN: 3479).
# TURN_URL=turn:203.0.113.10:3479
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Admin map tiles (Leaflet URL template) and their attribution.
# MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
# Reverse geocoding for device addresses (Nominatim-compatible /reverse endpoint).
# GEOCODER_URL=https://nominatim.openstreetmap.org/reverse
# GEOCODER_USER_AGENT=   # default: EUD-Remote-Assist-Portal/<version> (<PUBLIC_BASE_URL host>)

# PhoneDB marketing names for device models. PHONEDB_ENABLED=false uses built-in names only.
# PHONEDB_ENABLED=true
# Only if phonedb.net's TLS chain won't verify on your host:
PHONEDB_TLS_INSECURE=false
